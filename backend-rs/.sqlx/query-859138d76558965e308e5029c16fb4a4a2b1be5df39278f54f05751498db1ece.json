  "db_name": "MySQL",
  "query": "SELECT k.`id`, k.`title`, k.`column_id`, k.`position`, (CASE WHEN k.`description` IS NOT NULL AND k.`description` REGEXP '[^[:space:]]' THEN 1 ELSE 0 END) AS \"has_description: i64\", k.`due_date` AS \"due_date: chrono::NaiveDateTime\", k.`created_at` AS \"created_at: chrono::NaiveDateTime\", k.`updated_at` AS \"updated_at: chrono::NaiveDateTime\" FROM `cards` k WHERE k.`column_id` IN (SELECT c.`id` FROM `columns` c WHERE c.`board_id` = ?) ORDER BY k.`column_id` ASC, k.`position` ASC",
