# backend-rs configuration
#
# Copy to `.env` (next to this file, i.e. the crate root) and adjust. It is
# found by `dotenvy::dotenv()`, which searches from the process WORKING
# DIRECTORY upward, so run the binary from `backend-rs/` (or a child of it).
#
# Precedence: real environment  >  `.env`  >  built-in defaults.
# Keys with a stated constraint below are validated fail-fast at boot (see
# `src/config.rs`); validation errors name the key in UPPER_SNAKE, a missing
# required key is reported as its snake_case field name — never a secret.
# Not every key is checked: TRUSTED_PROXIES entries are matched leniently (a
# malformed entry silently never matches), DB_HOST/DB_USERNAME/DB_PASSWORD are
# free-form, and THROTTLE_*_PER_MIN=0 disables that limiter. A MISSPELLED key
# is silently ignored and falls back to its default — watch the boot log line.
#
# NEVER commit a real `.env`: it holds the DB password and the session secret.
#
# ---------------------------------------------------------------------------
# IMPORTANT: `NODE_ENV` must NOT be set.
# backend-rs is a Rust service; the runtime-mode key is `APP_ENV`. Boot FAILS
# when `NODE_ENV` is present, because `APP_ENV` defaults to `development` — a
# stale `NODE_ENV=production` would otherwise boot as `development` and silently
# lose Secure cookies, the `__Host-` prefix, prod HSTS and the production CORS
# policy (an explicitly empty list ⇒ deny all). (The Nest service in `backend/`
# keeps `NODE_ENV`; separate process.)
# ---------------------------------------------------------------------------


# --- Runtime mode ----------------------------------------------------------
# development | test | production   (default: development)
# production tightens: Secure session cookie + `__Host-kanpad.sid` prefix,
# HSTS header, JSON logs, and rejects an explicitly EMPTY CORS_ORIGINS.
# JSON logs only happen when APP_ENV is EXPORTED: the log format is chosen
# before `.env` is read (see the note at the bottom of this file).
APP_ENV=development

# --- HTTP server -----------------------------------------------------------
# Public API port (u16; 0 is rejected). Default: 3001
PORT=3001

# --- Security --------------------------------------------------------------
# Cookie-signing secret. REQUIRED, at least 32 BYTES. Rotating it invalidates
# every session. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Argon2id time cost (`t`) for password hashing. Default: 2
# Must be >= 2 when APP_ENV=production. The test suite pins 1 for speed.
HASH_COST=2

# --- Database: parts (used only when DATABASE_URL is unset) ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=kanpad
DB_PASSWORD=
# Must be a plain MySQL identifier: start with a letter or underscore, then
# letters, digits, `_` or `$` (no leading digit, `-`, `.` or space).
DB_NAME=kanpad

# --- Database: connection pool --------------------------------------------
# Maximum pooled connections (>= 1). Default: 10
# Tune to the server's `max_connections` — it is not knowable at build time.
DB_MAX_CONNECTIONS=10
# Minimum idle connections (0 = keep none; must not exceed DB_MAX_CONNECTIONS).
# Default: 1
DB_MIN_CONNECTIONS=1

# --- Database: startup / readiness probes ---------------------------------
# require | warn   (default: require)
#   require = exit non-zero when the DB is unreachable at boot (before the
#             session sweeper starts, before the port is bound, before
#             `--auto-migrate`)
#   warn    = log a warning and serve degraded (/health 200, /ready 503);
#             warn NEVER exempts `--auto-migrate` from needing a database
DB_STARTUP_CHECK=require

# Total retry budget (seconds) for the boot probe. Range 1..=300. Default: 15
# Only TRANSIENT failures (refused / timeout / DNS / MySQL 1040 or 1203 "too
# many connections") consume the budget; permanent ones (1045 access denied,
# 1049 unknown database) fail on attempt 1.
DB_STARTUP_TIMEOUT_SECS=15

# Per-attempt dial cap (ms) for the boot probe AND /ready. Range 50..=3000.
# Default: 500. Keep an orchestrator's probe `timeoutSeconds` >= 2x this value
# (Kubernetes defaults it to 1 s).
DB_READY_PROBE_TIMEOUT_MS=500

# --- Auth / throttling -----------------------------------------------------
# Gates POST /api/v1/auth/register (true | false). Default: true
REGISTRATION_ENABLED=true

# Governor limits, per client IP, applied to /api/* only.
# Defaults: 120 / 5. A value of 0 DISABLES that limiter (the router stays
# unthrottled for that scope) — it is not rejected at boot.
THROTTLE_GLOBAL_PER_MIN=120
THROTTLE_AUTH_PER_MIN=5

# --- CORS / reverse proxy --------------------------------------------------
# Comma-separated browser-origin allowlist. Default: http://localhost:5173
# Each entry must be in CANONICAL browser form or boot FAILS, naming the bad
# entry: `http` or `https` scheme, lowercase scheme + host (a non-ASCII host
# must be punycode), no trailing slash, no explicit default port (:80 for
# http, :443 for https), no leading zero in a port, no path/query/fragment.
# `*` is rejected (the API always sends credentials, and browsers reject
# `*` + credentials).
# In production an EXPLICITLY EMPTY value fails the boot (fail closed). NOTE:
# OMITTING this key does NOT fail closed — it falls back to the dev default
# above, so a production deployment MUST set it explicitly.
CORS_ORIGINS=http://localhost:5173

# Comma-separated proxy IPs / IPv4 CIDRs whose DIRECT PEER may supply
# X-Forwarded-For (a malformed entry, or an IPv6 CIDR, is silently ignored).
# Only the immediate peer is matched; the RIGHTMOST non-trusted
# X-Forwarded-For entry becomes the client IP (append-only walk), so a
# trusted proxy MUST APPEND the peer IP rather than overwrite the header.
# Default: empty = never trust XFF, so a direct client cannot spoof its IP.
TRUSTED_PROXIES=

# --- Observability ---------------------------------------------------------
# Optional Prometheus scrape port. UNSET (line commented out) = no /metrics
# endpoint at all (fail-closed opt-in). It gets its OWN listener, so scrapes
# never touch the public API port, its auth, its CORS or its throttling.
# 0 is rejected, and `METRICS_PORT=` (present but EMPTY) is a boot error, not
# "unset". The scrape port is UNAUTHENTICATED — never expose it publicly.
#METRICS_PORT=9090

# --- Explicit DATABASE_URL (overrides the DB_* connection parts above) -----
# Optional; leave commented out to use the DB_* parts. When set it WINS over
# DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME (the boot log reports
# `db_source=DATABASE_URL`), but NOT over DB_MAX_CONNECTIONS,
# DB_MIN_CONNECTIONS or the three probe knobs, which still apply.
# It must parse as a MySQL URL with a PERCENT-ENCODED password and carry BOTH
# query parameters, or boot fails:
#   ?charset=utf8mb4&collation=utf8mb4_unicode_ci
# The collation pin is mandatory: sqlx 0.9 otherwise lets the SERVER pick, and
# MySQL 8's default `utf8mb4_0900_ai_ci` is a different collation from this
# schema's `utf8mb4_unicode_ci`.
# `DATABASE_URL=` (present but EMPTY) is a boot error, not "unset".
# Exceptional case: if the URL names NO database, DB_NAME is still used as the
# fallback and is still identifier-screened — so a bad DB_NAME can fail a boot
# that otherwise uses this URL.
# DATABASE_URL is also what sqlx's compile-time macros and the in-process test
# suites use (see the test section below).
#DATABASE_URL=mysql://kanpad:secret@localhost:3306/kanpad?charset=utf8mb4&collation=utf8mb4_unicode_ci


# ===========================================================================
# NOT configurable through this file
# ===========================================================================
#
# RUST_LOG — real environment only.
#   The tracing filter is built BEFORE `dotenvy` loads this file, so a
#   RUST_LOG line here has no effect. (For the same reason, an APP_ENV that
#   only exists in `.env` is honored for settings/security but NOT for the
#   log FORMAT decided at startup — export it for production. `export-openapi`
#   never initialises tracing at all.) Set it in the real environment instead:
#     RUST_LOG=backend_rs=debug,tower_http=info
#   Default when unset: backend_rs=info,tower_http=info
#
#
# Test / CI only — these are NOT application settings:
#
#   SQLX_OFFLINE          "true" = compile the `query!` macros from the
#                         committed `.sqlx/` cache with no database at all
#                         (clippy, CI, the Docker build)
#   E2E_BASE_URL          pins the PORT the black-box API suites bind their OWN
#                         in-process server on (unset = OS-assigned ephemeral
#                         port). It is NOT the URL of an already-running
#                         server — pointing it at a live port makes the suite
#                         fail with `AddrInUse`.
#   E2E_TARGET=nest       relaxes the black-box assertions to Nest-parity
#                         ("behavior class") expectations; the server under
#                         test is still the spawned Rust app.
#
#   `DATABASE_URL` (see above) additionally feeds sqlx's compile-time macros
#   and the `#[sqlx::test]` suites.
#
#   The local test MySQL/MariaDB containers and their credentials live in
#   `docker-compose.test.yml`. A git-ignored `.env.test` is a local developer
#   convenience only — no code, CI job or compose file reads it, and a fresh
#   clone does not have it.
