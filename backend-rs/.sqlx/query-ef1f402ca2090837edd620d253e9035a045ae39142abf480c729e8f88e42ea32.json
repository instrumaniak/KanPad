  "query": "SELECT cl.`card_id` AS \"card_id: i32\", l.`id` AS \"label_id: i32\", l.`name`, l.`color` FROM `card_labels` cl JOIN `labels` l ON l.`id` = cl.`label_id` JOIN `cards` k ON k.`id` = cl.`card_id` WHERE k.`column_id` IN (SELECT c.`id` FROM `columns` c WHERE c.`board_id` = ?) ORDER BY cl.`card_id` ASC, l.`id` ASC",
