# KanPad self-host appliance — environment template — PRODUCTION.
#
# Copy to .env (git-ignored) and fill in the three REQUIRED values, or export
# them in your environment. docker compose will refuse to boot with this
# guidance until they are set. See docs/self-hosting.md for the full guide.
#
# This is the compose / env-editor surface for the appliance only. The
# SERVICE's full configuration reference (every key, defaults, validation,
# precedence) is backend-rs/.env.example — that file is for running backend-rs
# natively (`backend-rs serve`) or the org's two-origin production deployment
# (docs/deployment.md).

# --- REQUIRED ----------------------------------------------------------------
# Cookie-signing secret, at least 32 bytes. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Your public origin (the URL you will open in the browser). REQUIRED, and in
# production it must be a NON-loopback origin — loopback entries are refused
# at boot. In the same-origin appliance this value is never consulted by
# browsers (their same-origin requests bypass CORS); it exists to satisfy
# fail-closed production config. Set it to the domain you will use:
#   e.g. https://kanpad.example.com
# For a pure localhost try-out the example value is fine — localhost traffic
# bypasses CORS and localhost is a secure context, so login works.
CORS_ORIGINS=

# Password for the bundled database's `kanpad` user. Generate with:
#   openssl rand -hex 24
# Not the DB root password — that's auto-generated randomly (see compose.yaml).
DB_PASSWORD=

# --- OPTIONAL ----------------------------------------------------------------
APP_ENV=production
DB_NAME=kanpad
DB_USERNAME=kanpad
# DB probe timeout on cold boots (slow machines / first run). Seconds, 1-300.
# DB_STARTUP_TIMEOUT_SECS=120
# Password hashing cost (>=2 in production).
# HASH_COST=2
# Open registration. Set false to close registration after you create accounts.
# REGISTRATION_ENABLED=true
# Trust your TLS proxy so throttling keys on the real client IP —
# set it to the proxy's stable address (e.g. Dokploy's ingress network CIDR);
# container task IPs drift, do not pin one. Empty = never trusted.
# TRUSTED_PROXIES=
#
# External database? Comment out BOTH db blocks in compose.yaml, then set:
#   DB_HOST=your-db-host
#   DB_PORT=3306
#   DB_USERNAME=kanpad
#   DB_PASSWORD=…
#   DB_NAME=kanpad
# or DATABASE_URL=mysql://user:pass@host:3306/kanpad?charset=utf8mb4&collation=utf8mb4_unicode_ci
