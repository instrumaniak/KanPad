  "query": "SELECT c.`id` AS \"id!\", c.`board_id` AS \"board_id!: i32\", c.`name` AS \"name!\", (SELECT COUNT(*) FROM `columns` p WHERE p.`board_id` = c.`board_id` AND p.`sort_key` < c.`sort_key`) AS \"position!: i64\", c.`created_at` AS \"created_at!\", c.`updated_at` AS \"updated_at!\" FROM `columns` c JOIN `boards` b ON b.`id` = c.`board_id` WHERE c.`id` = ? AND b.`user_id` = ?",
