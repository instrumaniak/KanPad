  "query": "SELECT cl.`id`, cl.`title`, cl.`card_id` AS \"card_id: i32\", cl.`created_at`, cl.`updated_at` FROM `checklists` cl JOIN `cards` k ON k.`id` = cl.`card_id` JOIN `columns` c ON c.`id` = k.`column_id` JOIN `boards` b ON b.`id` = c.`board_id` WHERE cl.`id` = ? AND b.`user_id` = ?",
