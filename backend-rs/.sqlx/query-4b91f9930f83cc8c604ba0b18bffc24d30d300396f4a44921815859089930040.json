  "query": "SELECT cl.`card_id` AS \"card_id: i32\", COUNT(ci.`id`) AS \"total: i64\", COUNT(CASE WHEN ci.`is_completed` <> 0 THEN 1 END) AS \"completed: i64\" FROM `checklists` cl LEFT JOIN `checklist_items` ci ON ci.`checklist_id` = cl.`id` WHERE cl.`card_id` IN (SELECT k.`id` FROM `cards` k WHERE k.`column_id` IN (SELECT c.`id` FROM `columns` c WHERE c.`board_id` = ?)) GROUP BY cl.`card_id`",
