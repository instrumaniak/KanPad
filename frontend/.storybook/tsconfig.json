{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.storybook.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "msw-storybook-addon/csf3"],
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  // Stories are owned by tsconfig.app.json (free type coverage, gates `npm run build`);
  // this project covers only .storybook/ itself.
  "include": ["./**/*"]
}