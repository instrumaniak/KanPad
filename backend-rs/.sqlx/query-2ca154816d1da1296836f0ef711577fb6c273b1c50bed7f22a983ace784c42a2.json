  "query": "SELECT i.`id` AS \"id!\", i.`text` AS \"text!\", i.`is_completed` AS \"is_completed!\", i.`checklist_id` AS \"checklist_id!: i32\", (SELECT COUNT(*) FROM `checklist_items` p WHERE p.`checklist_id` = i.`checklist_id` AND p.`sort_key` < i.`sort_key`) AS \"position!: i64\", i.`created_at` AS \"created_at!\", i.`updated_at` AS \"updated_at!\" FROM `checklist_items` i JOIN `checklists` cl ON cl.`id` = i.`checklist_id` JOIN `cards` k ON k.`id` = cl.`card_id` JOIN `columns` c ON c.`id` = k.`column_id` JOIN `boards` b ON b.`id` = c.`board_id` WHERE i.`id` = ? AND b.`user_id` = ?",
