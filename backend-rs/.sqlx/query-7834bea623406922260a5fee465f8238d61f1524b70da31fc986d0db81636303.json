  "query": "SELECT k.`id` AS \"id!\", k.`title` AS \"title!\", k.`column_id` AS \"column_id!: i32\", (SELECT COUNT(*) FROM `cards` p WHERE p.`column_id` = k.`column_id` AND p.`sort_key` < k.`sort_key`) AS \"position!: i64\", k.`description` AS \"description: String\", k.`due_date`, k.`created_at` AS \"created_at!\", k.`updated_at` AS \"updated_at!\" FROM `cards` k JOIN `columns` c ON c.`id` = k.`column_id` JOIN `boards` b ON b.`id` = c.`board_id` WHERE k.`id` = ? AND b.`user_id` = ?",
