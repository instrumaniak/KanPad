# VITE_API_URL=https://api-kanpad-rs.raziur.com
# Dev default (for local development):
VITE_API_URL=http://localhost:3001

# --- e2e (Playwright, T017) ---
# One-command local run — provisions + migrates the throwaway `kanpad_e2e`
# schema (never the dev DB), then runs the suite against backend-rs (:3001)
# + the Vite dev server (:5173):
#   npm run test:e2e
# Prerequisites: a reachable MySQL/MariaDB (creds from ../backend-rs/.env:
# DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD), the `mysql` client (schema
# creation), and a backend-rs build (the first run compiles). The API under
# test always boots with APP_ENV=test + THROTTLE_AUTH_PER_MIN=10000 +
# THROTTLE_GLOBAL_PER_MIN=10000 — the default auth bucket is 5/min per IP and
# would 429 a suite that comes from 127.0.0.1. (backend-rs documents 0 as
# "disable", but the app's governor build coerces the burst to .max(1), so 0
# silently means 1 req/min — use 10000 instead.)
#
# Bare `npx playwright test` uses the same DB derivation but does NOT
# provision `kanpad_e2e` — run `npm run test:e2e` once before it.
#
# Pins (each skips the matching webServer):
#   E2E_BASE_URL=http://localhost:3001  — API already running (CI's container)
#   E2E_SPA_URL=http://localhost:5173   — SPA already running
#   E2E_DATABASE_URL=mysql://...        — override the DB derivation entirely
#
# Reuse caveat: a reused Vite dev server MUST be started with
# VITE_API_URL=http://localhost:3001, else the browser path silently degrades
# to same-origin (the suite would still pass and cover less). Never run while
# something holds :3001 — the API webServer always boots fresh against
# kanpad_e2e (reuseExistingServer is false).
#
# kanpad_e2e is throwaway — recreate freely:
#   DROP DATABASE IF EXISTS kanpad_e2e;
# (fixtures are 409-tolerant, so stale rows don't break re-runs)

# --- CI ---
# The docker-e2e job in .github/workflows/backend-rs.yml runs the same suite:
# it migrates the built image against `kanpad_e2e`, serves it on :3001 and
# exports E2E_BASE_URL=http://localhost:3001 (API pin; no second API boot),
# with the SPA served by Playwright's own Vite webServer (:5173).
